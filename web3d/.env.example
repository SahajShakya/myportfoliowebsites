# ================================
# Frontend (Vite) — copy to .env for local development
# ================================
# Same-origin API in production (/api); absolute URL for local dev server
VITE_API_URL=http://localhost:8000/api

# EmailJS (contact form)
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=

# ================================
# Backend (PHP) — loaded from public/api/.env (production)
# or the repo-root .env (development) by public/api/config/database.php
# ================================
# Development database
DB_HOST=localhost
DB_NAME=web3d_portfolio
DB_USER=root
DB_PASSWORD=

# Production database (InfinityFree MySQL)
DB_HOST_PROD=sql112.infinityfree.com
DB_NAME_PROD=
DB_USER_PROD=
DB_PASSWORD_PROD=
DB_PORT_PROD=3306

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Setup token — protects /api/setup and /api/migrate-paths
SETUP_TOKEN=change-me

# SMTP (contact form email)
SMTP_USER=
SMTP_FROM=Portfolio Contact Form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_PASS=

# AI Chatbot (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
CHAT_MAX_HISTORY=10
CHAT_MAX_CHUNKS=5
