{
  "name": "web3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/bundle-env.mjs",
    "build:prod": "vite build --mode production && node scripts/bundle-env.mjs",
    "chat:export": "php scripts/export_knowledge.php",
    "chat:export:prod": "php scripts/export_knowledge.php production",
    "chat:bundle": "node scripts/bundle-worker.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed": "php scripts/seed.php",
    "seed:prod": "php scripts/seed.php production",
    "db:dump": "bash scripts/dump.sh",
    "db:dump:prod": "bash scripts/dump.sh production",
    "admin": "node scripts/admin.js",
    "server": "php -S localhost:8000 -d upload_max_filesize=50M -d post_max_size=50M -d max_file_uploads=20 .htrouter.php",
    "start": "php -S localhost:8000 -d upload_max_filesize=50M -d post_max_size=50M -d max_file_uploads=20 .htrouter.php",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "know": "php scripts/build_knowledge.php",
    "migrate:chat": "php scripts/migrate_chat.php",
    "migrate:chat:prod": "php scripts/migrate_chat.php production",
    "know:prod": "php scripts/build_knowledge.php production"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emailjs/browser": "^4.4.1",
    "@react-spring/three": "^9.7.5",
    "@react-three/drei": "^9.121.3",
    "@react-three/fiber": "^8.17.12",
    "@tailwindcss/postcss": "^4.0.6",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.64.2",
    "@types/three": "^0.172.0",
    "axios": "^1.18.1",
    "dotenv": "^16.4.7",
    "draft-js": "^0.11.7",
    "formik": "^2.4.6",
    "framer-motion": "^12.0.5",
    "js-cookie": "^3.0.8",
    "nepali-date-converter": "^3.3.3",
    "notistack": "^3.0.2",
    "prop-types": "^15.8.1",
    "quill": "^2.0.3",
    "quill-better-table": "^1.2.10",
    "quill-table-module": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draft-wysiwyg": "^1.15.0",
    "react-dropzone": "^14.3.5",
    "react-icons": "^5.4.0",
    "react-on-screen": "^2.1.1",
    "react-query": "^3.39.3",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.1.3",
    "react-tilt": "^1.0.2",
    "react-vertical-timeline-component": "^3.5.3",
    "three": "^0.172.0",
    "three-stdlib": "^2.35.12",
    "yup": "^1.6.1"
